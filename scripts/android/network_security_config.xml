<?xml version="1.0" encoding="utf-8"?>
<!--
  Introvert Android network security config.

  Cleartext (http://) is blocked everywhere EXCEPT the loopback addresses the
  in-app OAuth flow uses: after the user authorizes on the Extrovert consent
  page, the app's WebView returns to http://localhost:1420/oauth/callback
  where the native OAuth listener (bound to 127.0.0.1:1420 in this process)
  captures the code. Everything else stays HTTPS-only.

  This file is copied into src-tauri/gen/android/.../res/xml by the release
  workflow after `tauri android init` (gen/ is generated and gitignored).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">tauri.localhost</domain>
    </domain-config>
</network-security-config>
